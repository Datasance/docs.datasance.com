{
  "name": "docs.datasance.com",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "DOCUSAURUS_DISTRIBUTION=datasance docusaurus start",
    "build": "DOCUSAURUS_DISTRIBUTION=datasance docusaurus build && node scripts/seo/postbuild-seo.js",
    "build:datasance": "DOCUSAURUS_DISTRIBUTION=datasance docusaurus build && node scripts/seo/postbuild-seo.js",
    "build:iofog": "DOCUSAURUS_DISTRIBUTION=iofog docusaurus build && node scripts/seo/postbuild-seo.js",
    "postbuild:seo": "node scripts/seo/postbuild-seo.js",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "check:cli-fences": "node scripts/check-cli-name-fences.js",
    "fix:flavor-inline-code": "node scripts/fix-flavor-inline-code.js",
    "sync:cli": "node scripts/sync-cli-docs.js",
    "convert:cli": "node scripts/convert-cli-md-to-mdx.js potctl && node scripts/convert-cli-md-to-mdx.js iofogctl",
    "prepare:cli": "npm run sync:cli && npm run convert:cli"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/plugin-client-redirects": "^3.10.1",
    "@docusaurus/plugin-google-gtag": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "^3.10.1",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "redocusaurus": "^2.5.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "typescript": "~5.5.2"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "node-forge": "1.4.0",
    "qs": "6.15.3",
    "serialize-javascript": "7.0.7",
    "fast-xml-parser": "^5.9.3",
    "fast-xml-builder": "^1.2.1",
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.7",
    "shell-quote": "^1.9.0",
    "picomatch": "^2.3.2",
    "postcss": "^8.5.16",
    "follow-redirects": "^1.16.0",
    "http-proxy-middleware": "^2.0.10",
    "joi": "^17.13.4",
    "fast-uri": "^4.1.0",
    "js-yaml": "^4.3.0",
    "gray-matter": {
      "js-yaml": "3.15.0"
    },
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "webpack-bundle-analyzer": {
      "ws": "7.5.11"
    },
    "ws": "^8.21.0",
    "yaml": "^1.10.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24.0"
  }
}
